{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archive-workbench-ai/request-0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "created_at", "task", "input", "targets", "execution", "generation", "output"],
  "properties": {
    "protocol": {"const": "archive-workbench-ai/0.1"},
    "request_id": {"type": "string", "format": "uuid"},
    "created_at": {"type": "string", "format": "date-time"},
    "task": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"const": "vision_describe"}, "version": {"const": "0.1"}}
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle_type", "sha256"],
      "properties": {
        "bundle_type": {"const": "exp01"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "targets": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target_id", "target_type"],
        "properties": {
          "target_id": {"type": "string", "minLength": 1},
          "target_type": {"enum": ["page", "region", "figure"]}
        }
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["network_policy", "hardware_profile", "seed"],
      "properties": {
        "network_policy": {"const": "offline_required"},
        "hardware_profile": {"enum": ["auto", "L12", "H24"]},
        "seed": {"type": "integer"}
      }
    },
    "generation": {
      "type": "object", "additionalProperties": false,
      "required": ["max_output_tokens", "temperature"],
      "properties": {
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2}
      }
    },
    "output": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id"],
      "properties": {"schema_id": {"const": "vision_describe/0.1"}}
    }
  }
}
